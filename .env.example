# AiKyaStor CONTROL environment template. Copy to backend/.env (backend)
# and .env (frontend VITE_* values). Every value shown is the code default
# except where noted.

# ─── Application ─────────────────────────────────────────────────────────────
APP_MODE=simulation
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_THREADED=true
FLASK_DEBUG=false

# ─── Ceph RGW (S3) ───────────────────────────────────────────────────────────
# Most S3 operations use CEPH_RGW_ENDPOINT. SSE-S3 requests use the HTTPS
# endpoint. Required in production mode: CEPH_ACCESS_KEY / CEPH_SECRET_KEY.
CEPH_RGW_ENDPOINT=http://192.168.29.252:80
CEPH_RGW_ENDPOINT_SECURE=https://192.168.56.110:443
CEPH_ACCESS_KEY=
CEPH_SECRET_KEY=
CEPH_REGION=us-east-1

# ─── CephFS / RBD ────────────────────────────────────────────────────────────
CEPHFS_MOUNT=/mnt/cephfs
CEPHFS_NAME=cephfs
CEPHFS_USER=admin
CEPHFS_MONITORS=
CEPHFS_KEYRING=/etc/ceph/ceph.client.admin.keyring
RBD_POOL=rbd
CEPH_CONF=/etc/ceph/ceph.conf

# ─── Vault Backup mount (NOT HashiCorp Vault) ────────────────────────────────
VAULT_PATH=/vault

# ─── HashiCorp Vault (SSE-S3 KMS) ────────────────────────────────────────────
# Required in production mode: HASHICORP_VAULT_TOKEN.
HASHICORP_VAULT_ADDR=http://127.0.0.1:8200
HASHICORP_VAULT_TOKEN=

# ─── Replication ─────────────────────────────────────────────────────────────
REPLICATION_SECONDARY_HOST=
REPLICATION_SECONDARY_USER=
REPLICATION_SSH_CONNECT_TIMEOUT=5
REPLICATION_SSH_TIMEOUT=20
REPLICATION_SSH_SNAPSHOT_TIMEOUT=45
REPLICATION_CIRCUIT_BREAKER_COOLDOWN=30

# ─── Ceph-AI monitoring ──────────────────────────────────────────────────────
CEPH_AI_ENABLED=false
CEPH_AI_DB_PATH=/opt/ceph-ai/ceph_monitor.db
CEPH_AI_DB_TIMEOUT=3.0
CEPH_AI_STALE_AFTER_SECONDS=30

# ─── Post-Quantum Cryptography telemetry (see PQC_ARCHITECTURE_AND_SETUP.md) ─
# Endpoint probed for the negotiated TLS key-exchange group.
# Default: CEPH_RGW_ENDPOINT_SECURE. With an SSH tunnel: https://127.0.0.1:8444
PQC_PROBE_ENDPOINT=
# Must be able to OFFER ML-KEM: OpenSSL >= 3.5, or an older openssl with
# oqsprovider enabled via OPENSSL_CONF. Otherwise the status is "unverified".
PQC_OPENSSL_BIN=openssl
PQC_EXPECTED_GROUP=X25519MLKEM768
PQC_PROBE_TIMEOUT=5
PQC_CACHE_SECONDS=60

# ─── Logging / commands ──────────────────────────────────────────────────────
CMD_TIMEOUT=30
LOG_LEVEL=INFO
LOG_FORMAT=standard

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_APP_MODE=simulation
